# Frontend Environment Variables
# Copy this file to .env.local and fill in the values

# API URL - the URL of the backend API
# In development with proxy: leave empty or use /api
# In production: use the full URL of your Render backend, e.g. https://tutti-backend.onrender.com/api
VITE_API_URL=

# hCaptcha site key (for checkout CAPTCHA)
# This should match the HCAPTCHA_SITE_KEY on the backend
# Get your site key at https://dashboard.hcaptcha.com/
VITE_HCAPTCHA_SITE_KEY=
