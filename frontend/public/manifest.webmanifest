{
  "name": "Tutti Muziek App",
  "short_name": "Tutti",
  "description": "Muziekvereniging beheer applicatie",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#1976d2",
  "orientation": "portrait-primary",
  "icons": [
    {
      "src": "/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-192x192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/icon-512x512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/desktop.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide"
    },
    {
      "src": "/screenshots/mobile.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow"
    }
  ],
  "shortcuts": [
    {
      "name": "Mijn Muziek",
      "short_name": "Muziek",
      "description": "Bekijk je partituren",
      "url": "/my-music",
      "icons": [{ "src": "/icons/music.svg", "sizes": "96x96" }]
    },
    {
      "name": "Repetities",
      "short_name": "Repetities",
      "description": "Bekijk het repetitierooster",
      "url": "/rehearsals",
      "icons": [{ "src": "/icons/calendar.svg", "sizes": "96x96" }]
    },
    {
      "name": "Mijn Tickets",
      "short_name": "Tickets",
      "description": "Bekijk je concerttickets",
      "url": "/my-tickets",
      "icons": [{ "src": "/icons/ticket.svg", "sizes": "96x96" }]
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": ["application/pdf", ".pdf"]
        }
      ]
    }
  },
  "categories": ["music", "productivity", "utilities"],
  "lang": "nl",
  "dir": "ltr"
}
