# Tutti Environment Variables
# Copy this file to .env and fill in the values

# =============================================================================
# Required Settings
# =============================================================================

# Domain name for your Tutti instance (without https://)
DOMAIN=tutti.example.com

# Email for Let's Encrypt SSL certificates
ACME_EMAIL=admin@example.com

# JWT Secret - CHANGE THIS! Generate with: openssl rand -base64 32
JWT_SECRET=your-very-secure-secret-key-change-this

# =============================================================================
# Optional Settings
# =============================================================================

# Initial admin password (only used on first startup)
# If not set, a random password will be generated and logged
ADMIN_INIT_PASSWORD=

# JWT token expiration (default: 7d)
JWT_EXPIRES_IN=7d

# Log level: debug, info, warn, error (default: info)
LOG_LEVEL=info

# =============================================================================
# Production Settings (docker-compose.prod.yml)
# =============================================================================

# Traefik dashboard basic auth
# Generate with: echo $(htpasswd -nb admin yourpassword) | sed -e s/\\$/\\$\\$/g
TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$xyz...

# =============================================================================
# Development Settings (optional)
# =============================================================================

# Frontend API URL (default: /api for production, http://localhost:3001/api for dev)
# VITE_API_URL=http://localhost:3001/api
