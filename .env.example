# Tutti/Harmonie Environment Variables
# Copy this file to .env and fill in the values
#
# Legend:
#   [REQUIRED]  - Must be set for the application to work
#   [REQUIRED*] - Required in production only
#   [OPTIONAL]  - Has sensible defaults or enables optional features

# =============================================================================
# Required Settings
# =============================================================================

# Domain name for your Tutti instance (without https://)
# [REQUIRED] Used for SSL certificates and CORS
DOMAIN=tutti.example.com

# Email for Let's Encrypt SSL certificates
# [REQUIRED] Used by Traefik for ACME certificate registration
ACME_EMAIL=admin@example.com

# JWT Secret for signing authentication tokens
# [REQUIRED] CHANGE THIS! Generate with: openssl rand -base64 32
# Must be at least 32 characters in production
JWT_SECRET=your-very-secure-secret-key-change-this

# Frontend URL for CORS configuration
# [REQUIRED*] Must be set in production for CORS
# Default: http://localhost:5173 (development)
FRONTEND_URL=https://tutti.example.com

# Backend API URL (used for webhooks and callbacks)
# [OPTIONAL] Default: http://localhost:3000
API_URL=https://api.tutti.example.com

# =============================================================================
# Database Settings
# =============================================================================

# Path to SQLite database file
# [OPTIONAL] Default: ./data/harmonie.db
DB_PATH=./data/harmonie.db

# Enable automated database backups
# [OPTIONAL] Default: true (set to 'false' to disable)
BACKUP_ENABLED=true

# Hours between automated database backups
# [OPTIONAL] Default: 24
BACKUP_INTERVAL_HOURS=24

# Days to keep old backups before automatic deletion
# [OPTIONAL] Default: 14
BACKUP_RETENTION_DAYS=14

# Directory for automated database backups
# [OPTIONAL] Default: 'backups/' directory next to the database file
BACKUP_DIR=

# =============================================================================
# Server Settings
# =============================================================================

# Server port
# [OPTIONAL] Default: 3001
PORT=3001

# Node environment: development, production, test
# [OPTIONAL] Default: development
NODE_ENV=production

# JWT token expiration time
# [OPTIONAL] Default: 7d (7 days)
# Format: number + unit (s=seconds, m=minutes, h=hours, d=days)
JWT_EXPIRES_IN=7d

# Initial admin password (only used on first database initialization)
# [OPTIONAL] If not set, a random password will be generated and logged
ADMIN_INIT_PASSWORD=

# Promote a user to super admin by email (used during startup)
# [OPTIONAL] Set to an email address to grant super admin privileges
MAKE_SUPER_ADMIN=

# =============================================================================
# Email/SMTP Settings
# =============================================================================

# SMTP server hostname
# [OPTIONAL] If not set, email sending is disabled
SMTP_HOST=smtp.example.com

# SMTP server port
# [OPTIONAL] Default: 587
SMTP_PORT=587

# Use secure TLS connection
# [OPTIONAL] Default: false (uses STARTTLS on port 587)
# Set to 'true' for implicit TLS on port 465
SMTP_SECURE=false

# SMTP authentication username
# [OPTIONAL] Usually your email address
SMTP_USER=noreply@example.com

# SMTP authentication password
# [OPTIONAL] Your SMTP password or app-specific password
SMTP_PASS=your-smtp-password

# From address for outgoing emails
# [OPTIONAL] Default: "Harmonie App" <noreply@harmonie.app>
SMTP_FROM="Tutti App" <noreply@example.com>

# =============================================================================
# Payment Integration
# =============================================================================

# Mollie API key for payment processing (EU/Netherlands)
# [OPTIONAL] Get from https://www.mollie.com/dashboard
# Starts with 'test_' for sandbox or 'live_' for production
MOLLIE_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Stripe secret key for payment processing
# [OPTIONAL] Get from https://dashboard.stripe.com/apikeys
# Starts with 'sk_test_' for sandbox or 'sk_live_' for production
STRIPE_SECRET_KEY=sk_test_YOUR_SECRET_KEY

# Stripe webhook signing secret
# [OPTIONAL] Get from Stripe dashboard when setting up webhooks
# Starts with 'whsec_'
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SIGNING_SECRET

# =============================================================================
# Social Authentication (Guest Checkout)
# =============================================================================

# Google OAuth client ID
# [OPTIONAL] Get from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Google OAuth client secret
# [OPTIONAL] Get from Google Cloud Console
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx

# Facebook App ID
# [OPTIONAL] Get from https://developers.facebook.com/apps/
FACEBOOK_APP_ID=xxxxxxxxxxxxxxxx

# Facebook App Secret
# [OPTIONAL] Get from Facebook Developer Console
FACEBOOK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OAuth callback URL base (frontend URL for OAuth redirects)
# [OPTIONAL] Default: FRONTEND_URL value
SOCIAL_AUTH_CALLBACK_URL=https://tutti.example.com

# =============================================================================
# Push Notifications (Web Push / VAPID)
# =============================================================================

# VAPID public key for web push notifications
# [OPTIONAL] Generate keypair with: npx web-push generate-vapid-keys
# Must be set together with VAPID_PRIVATE_KEY
VAPID_PUBLIC_KEY=BxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxQ

# VAPID private key for web push notifications
# [OPTIONAL] Generate keypair with: npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# VAPID subject (contact URL or mailto: for push service)
# [OPTIONAL] Default: mailto:admin@harmonie.app
VAPID_SUBJECT=mailto:admin@example.com

# =============================================================================
# Messaging - WhatsApp (Meta Business API)
# =============================================================================

# WhatsApp Business API base URL
# [OPTIONAL] Default: https://graph.facebook.com/v18.0
WHATSAPP_API_URL=https://graph.facebook.com/v18.0

# WhatsApp Phone Number ID from Meta Business Suite
# [OPTIONAL] Get from Meta Business Suite > WhatsApp Manager
WHATSAPP_PHONE_NUMBER_ID=xxxxxxxxxxxxxxxxxxxx

# WhatsApp API access token
# [OPTIONAL] Generate from Meta Business Suite
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Webhook verification token for WhatsApp
# [OPTIONAL] You define this; use same value in Meta webhook config
# Default: randomly generated on startup
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token

# =============================================================================
# Messaging - Twilio (Alternative WhatsApp Provider)
# =============================================================================

# Twilio Account SID
# [OPTIONAL] Get from https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Twilio Auth Token
# [OPTIONAL] Get from Twilio Console
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Twilio WhatsApp sender number
# [OPTIONAL] Format: whatsapp:+14155238886 (Twilio sandbox) or your approved number
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# =============================================================================
# Messaging - Telegram
# =============================================================================

# Telegram Bot Token
# [OPTIONAL] Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=xxxxxxxxxx:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Gedeeld geheim tussen Telegram en deze server. Verplicht zodra je Telegram
# gebruikt: de webhook staat open op het internet en /stop verbreekt een
# koppeling op grond van het chat-id uit de body. Zonder dit geheim weigert de
# webhook elk verzoek.
#
# Geef dezelfde waarde mee bij het registreren van de webhook:
#   curl -X POST "https://api.telegram.org/bot<token>/setWebhook" \
#        -d "url=https://<jouw-host>/api/notifications/telegram/webhook" \
#        -d "secret_token=<dit-geheim>"
#
# Zelf er een maken: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# =============================================================================
# Music Services - Spotify
# =============================================================================

# Spotify Client ID for API access
# [OPTIONAL] Get from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Spotify Client Secret
# [OPTIONAL] Get from Spotify Developer Dashboard
SPOTIFY_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# Music Services - Apple Music
# =============================================================================

# Apple Developer Team ID
# [OPTIONAL] Get from https://developer.apple.com/account
APPLE_MUSIC_TEAM_ID=XXXXXXXXXX

# Apple Music API Key ID
# [OPTIONAL] Get from Apple Developer Console > Keys
APPLE_MUSIC_KEY_ID=XXXXXXXXXX

# Apple Music API Private Key (MusicKit key contents)
# [OPTIONAL] The .p8 key file contents, keep newlines as \n
# Generate from Apple Developer Console > Keys > MusicKit
APPLE_MUSIC_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIGTAgEAMBM...\n-----END PRIVATE KEY-----

# =============================================================================
# Security Settings
# =============================================================================

# Encryption secret for sensitive data at rest
# [OPTIONAL] Default: uses JWT_SECRET if not set
# Generate with: openssl rand -base64 32
ENCRYPTION_SECRET=

# Encryption salt for key derivation
# [OPTIONAL] Default: derived from secret
# Generate with: openssl rand -hex 16
ENCRYPTION_SALT=

# QR code signing secret for ticket validation
# [REQUIRED*] Must be set in production for secure ticket QR codes
# Generate with: openssl rand -base64 32
QR_SECRET=your-qr-code-secret-change-this

# Offline sync encryption secret for ticket scanners
# [REQUIRED*] Must be set in production for offline ticket validation
# Generate with: openssl rand -base64 32
OFFLINE_SYNC_SECRET=your-offline-sync-secret-change-this

# =============================================================================
# CAPTCHA Protection (hCaptcha)
# =============================================================================

# Enable/disable CAPTCHA protection
# [OPTIONAL] Default: true (set to 'false' to disable)
CAPTCHA_ENABLED=true

# hCaptcha site key (public)
# [OPTIONAL] Get from https://dashboard.hcaptcha.com
HCAPTCHA_SITE_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# hCaptcha secret key
# [OPTIONAL] Get from hCaptcha dashboard
HCAPTCHA_SECRET_KEY=0xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxXX

# =============================================================================
# CSRF Protection
# =============================================================================

# Enable CSRF protection
# [OPTIONAL] Default: false
CSRF_ENABLED=true

# CSRF cookie name
# [OPTIONAL] Default: csrf_token
CSRF_COOKIE_NAME=csrf_token

# CSRF header name
# [OPTIONAL] Default: x-csrf-token
CSRF_HEADER_NAME=x-csrf-token

# =============================================================================
# Rate Limiting
# =============================================================================

# Rate limit window in milliseconds
# [OPTIONAL] Default: 900000 (15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Maximum requests per window (general endpoints)
# [OPTIONAL] Default: 1000
RATE_LIMIT_MAX_REQUESTS=1000

# Maximum requests per window (auth endpoints - stricter)
# [OPTIONAL] Default: 10
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# =============================================================================
# IP Whitelisting (Admin Access)
# =============================================================================

# Enable IP whitelisting for admin routes
# [OPTIONAL] Default: false
IP_WHITELIST_ENABLED=false

# Comma-separated list of allowed IPs for admin access
# [OPTIONAL] Only used when IP_WHITELIST_ENABLED=true
ADMIN_ALLOWED_IPS=192.168.1.1,10.0.0.1

# =============================================================================
# File Storage Settings
# =============================================================================

# Directory for uploaded files (PDFs, images)
# [OPTIONAL] Default: ./uploads
UPLOAD_DIR=./uploads

# Directory for uploaded MP3 audio files
# [OPTIONAL] Default: ./uploads/mp3
MP3_UPLOAD_DIR=./uploads/mp3

# Directory for uploaded MusicXML files
# [OPTIONAL] Default: ./uploads/musicxml
MUSICXML_UPLOAD_DIR=./uploads/musicxml

# Directory for temporary files (PDF processing, etc.)
# [OPTIONAL] Default: ./temp
TEMP_DIR=./temp

# Maximum file upload size in bytes
# [OPTIONAL] Default: 52428800 (50MB)
MAX_FILE_SIZE=52428800

# =============================================================================
# CDN Configuration
# =============================================================================

# Enable CDN for static file serving
# [OPTIONAL] Default: false
CDN_ENABLED=false

# CDN base URL
# [OPTIONAL] Only used when CDN_ENABLED=true
CDN_BASE_URL=https://cdn.example.com

# CDN static file path prefix
# [OPTIONAL] Default: /static
CDN_STATIC_PATH=/static

# =============================================================================
# Monitoring (Sentry)
# =============================================================================

# Sentry DSN for error tracking
# [OPTIONAL] Get from https://sentry.io project settings
# If not set, error monitoring is disabled
SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@o0.ingest.sentry.io/0

# =============================================================================
# Content Security Policy
# =============================================================================

# CSP violation report URI
# [OPTIONAL] Endpoint to receive CSP violation reports
CSP_REPORT_URI=https://your-csp-reporting-endpoint.com/report

# =============================================================================
# GDPR Compliance
# =============================================================================

# Hour of day (0-23) to run GDPR data cleanup job
# [OPTIONAL] Default: 3 (3 AM)
GDPR_CLEANUP_HOUR=3

# Days that soft-deleted records (users, music pieces, music titles,
# music lists, concerts) are kept before the GDPR cleanup job hard-deletes
# them, including associated files such as PDFs
# [OPTIONAL] Default: 30
SOFT_DELETE_RETENTION_DAYS=30

# =============================================================================
# Development Settings
# =============================================================================

# Log level: debug, info, warn, error
# [OPTIONAL] Default: info
LOG_LEVEL=info

# Frontend API URL override (for development)
# [OPTIONAL] Default: /api for production, http://localhost:3001/api for dev
# VITE_API_URL=http://localhost:3001/api

# =============================================================================
# Production Settings (docker-compose.prod.yml)
# =============================================================================

# Traefik dashboard basic auth credentials
# [OPTIONAL] Generate with: echo $(htpasswd -nb admin yourpassword) | sed -e s/\\$/\\$\\$/g
TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$xyz...
