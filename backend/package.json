{
  "name": "backend",
  "version": "1.12.0",
  "description": "Backend API voor harmonieorkest muziekbeheer",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/migrations/cli.js up && node dist/index.js",
    "db:init": "tsx src/database/init.ts",
    "migrate:up": "tsx src/migrations/cli.ts up",
    "migrate:down": "tsx src/migrations/cli.ts down",
    "migrate:status": "tsx src/migrations/cli.ts status",
    "migrate:create": "tsx src/migrations/cli.ts create",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:integration": "vitest run --include='src/__tests__/routes/**/*.test.ts'",
    "import:musicxml": "tsx src/scripts/import-musicxml.ts",
    "migrate:jskos": "tsx src/scripts/migrate-to-jskos.ts"
  },
  "dependencies": {
    "@sentry/node": "^10.53.1",
    "@types/compression": "^1.8.1",
    "@types/qrcode": "^1.5.6",
    "adm-zip": "^0.5.17",
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.2.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.22.2",
    "express-rate-limit": "^8.5.2",
    "fast-xml-parser": "^5.7.3",
    "helmet": "^8.2.0",
    "fast-xml-parser": "^5.8.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^7.0.13",
    "otplib": "^13.4.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.7.284",
    "qrcode": "^1.5.4",
    "rrule": "^2.8.1",
    "socket.io": "^4.8.3",
    "sql.js": "^1.14.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^5.13.1",
    "uuid": "^9.0.1",
    "web-push": "^3.6.7",
    "winston": "^3.19.0",
    "zod": "^4.4.3",
    "sanitize-html": "^2.17.3"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/archiver": "^7.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.19.42",
    "@types/nodemailer": "^7.0.9",
    "@types/rrule": "^2.2.9",
    "@types/supertest": "^7.2.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^9.0.7",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.8",
    "supertest": "^7.2.2",
    "tsx": "^4.22.4",
    "typescript": "^5.3.3",
    "vitest": "^4.0.18"
  }
}
