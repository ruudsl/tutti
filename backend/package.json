{
  "name": "backend",
  "version": "1.17.0",
  "description": "Backend API voor harmonieorkest muziekbeheer",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/migrations/cli.ts up && tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/migrations/cli.js up && node dist/index.js",
    "db:init": "tsx src/database/init.ts",
    "migrate:up": "tsx src/migrations/cli.ts up",
    "migrate:down": "tsx src/migrations/cli.ts down",
    "migrate:status": "tsx src/migrations/cli.ts status",
    "migrate:create": "tsx src/migrations/cli.ts create",
    "seed:e2e": "tsx src/scripts/seed-e2e.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:integration": "vitest run --include='src/__tests__/integration/**/*.test.ts'",
    "import:musicxml": "tsx src/scripts/import-musicxml.ts",
    "migrate:jskos": "tsx src/scripts/migrate-to-jskos.ts"
  },
  "dependencies": {
    "@sentry/node": "^10.72.0",
    "@types/compression": "^1.8.1",
    "@types/qrcode": "^1.5.6",
    "adm-zip": "^0.6.0",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "express-rate-limit": "^8.6.2",
    "fast-xml-parser": "^5.11.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "otplib": "^13.4.1",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "rrule": "^2.8.1",
    "sanitize-html": "^2.17.7",
    "socket.io": "^4.8.3",
    "sql.js": "^1.14.2",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^6.1.0",
    "uuid": "^14.0.2",
    "web-push": "^3.6.7",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/archiver": "^8.0.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/rrule": "^2.2.9",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^11.0.0",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.11",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^5.3.3",
    "vitest": "^4.0.18"
  }
}
