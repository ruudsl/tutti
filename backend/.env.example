# Backend Environment Variables
# Copy this file to .env and fill in the values

# Server settings
NODE_ENV=development
PORT=3001

# JWT secret. Leeg laten mag lokaal: dan gebruikt de applicatie een
# ontwikkelgeheim. In productie (NODE_ENV=production) start hij niet zonder een
# eigen, willekeurig geheim; voorbeeldwaarden en eentonige waarden als 'aaaa…'
# worden geweigerd. Maak er een met:
#   openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Sleutel voor opgeslagen geheimen (wachtwoorden en tokens van koppelingen).
# Leeg laten mag lokaal: dan valt de applicatie terug op JWT_SECRET. In
# productie start hij niet zonder een eigen, willekeurig geheim dat niet gelijk
# is aan JWT_SECRET. Maak er een met:
#   openssl rand -base64 48
ENCRYPTION_SECRET=

# Database
DB_PATH=./data/tutti.db

# Automated database backups
# Set to 'false' to disable scheduled backups (default: true)
BACKUP_ENABLED=true
# Hours between backups (default: 24)
BACKUP_INTERVAL_HOURS=24
# Days to keep old backups before deletion (default: 14)
BACKUP_RETENTION_DAYS=14
# Backup directory (default: 'backups/' next to the database file)
BACKUP_DIR=
# Dagen dat de kopie van vóór een terugzetting (pre-restore/) blijft staan (standaard: 30)
BACKUP_PRE_RESTORE_RETENTION_DAYS=30
# Back-ups worden versleuteld zodra ENCRYPTION_SECRET is ingesteld.

# Soft delete retention
# Days that soft-deleted records (users, music pieces, music titles,
# music lists, concerts) are kept before the GDPR cleanup job hard-deletes
# them, including associated files such as PDFs (default: 30)
SOFT_DELETE_RETENTION_DAYS=30

# File uploads
UPLOAD_DIR=./uploads
MP3_UPLOAD_DIR=./uploads/mp3
MAX_FILE_SIZE=52428800

# Initial admin password (only used on first run when database is empty)
# If not set, a random password will be generated and logged to console
ADMIN_INIT_PASSWORD=

# CORS - Frontend URL
FRONTEND_URL=http://localhost:5173

# Rate limiting (optional)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=5

# hCaptcha (privacy-friendly CAPTCHA for checkout protection)
# Get your keys at https://dashboard.hcaptcha.com/
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=
# Set to 'false' to disable CAPTCHA verification (default: true)
CAPTCHA_ENABLED=true

# Social Login (OAuth) - for guest checkout
# Google OAuth credentials (https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook OAuth credentials (https://developers.facebook.com/)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Social auth callback URL (defaults to FRONTEND_URL)
SOCIAL_AUTH_CALLBACK_URL=

# Google Agenda: OAuth-client van de installatie waarmee leden hun agenda
# koppelen (Google Calendar API aan, redirect-URI
# <FRONTEND_URL>/api/calendar/google/callback). Leeg: koppelen staat uit.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Web Push (PWA notifications)
# Generate a VAPID key pair with: npx web-push generate-vapid-keys
# Leaving these empty disables web push (other channels like email/Telegram still work)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
